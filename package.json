{
  "name": "docflow-desktop",
  "version": "0.5.0",
  "description": "Privacy-first desktop document automation for JSON/Excel/CSV and Word/PDF templates",
  "main": "desktop/main.js",
  "author": "DocFlow Local Contributors",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/docflowlocal/docflow-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/docflowlocal/docflow-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/docflowlocal/docflow-desktop/issues"
  },
  "keywords": [
    "document-automation",
    "mail-merge",
    "excel-to-pdf",
    "docx-template",
    "pdf-generation",
    "offline-first"
  ],
  "scripts": {
    "benchmark:engine": "node desktop/benchmark-engine.js",
    "test:api": "node desktop/engine-api-test.js",
    "test:pdf": "electron desktop/pdf-smoke.js",
    "test:ui": "electron desktop/ui-smoke.js",
    "test:packaged:mac": "\"dist/mac-arm64/DocFlow Local.app/Contents/MacOS/DocFlow Local\" --docflow-release-smoke",
    "test:packaged:mac:host": "zsh desktop/packaged-smoke-mac.sh",
    "test:packaged:win": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/release-smoke-win.ps1",
    "test:desktop": "npm run test:syntax && npm test && npm run test:api && npm run test:pdf && npm run test:ui",
    "desktop": "electron .",
    "desktop:debug": "DOCFLOW_DEBUG=1 electron .",
    "build:mac": "zsh desktop/package-mac.sh arm64",
    "build:mac:arm64": "zsh desktop/package-mac.sh arm64",
    "build:mac:x64": "zsh desktop/package-mac.sh x64",
    "build:mac:release": "zsh desktop/package-mac-release.sh arm64",
    "build:mac:release:x64": "zsh desktop/package-mac-release.sh x64",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/package-win.ps1",
    "build:win:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/package-win.ps1",
    "build:win:release": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/package-win-release.ps1",
    "pack:mac": "electron-builder --mac dir --arm64",
    "pack:mac:x64": "electron-builder --mac dir --x64",
    "pack:win": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/package-win.ps1 -DirectoryOnly",
    "test": "node desktop/expression-test.js && node desktop/template-engine-test.js && node desktop/smoke-test.js && node desktop/mvp-regression-test.js && node desktop/license-test.js && node desktop/project-format-test.js",
    "test:syntax": "node --check static/app.js && node --check static/i18n.js && node --check desktop/expression.js && node --check desktop/template-engine.js && node --check desktop/engine.js && node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/docx-render.js && node --check desktop/release-smoke.js && node --check desktop/pdf-smoke.js && node --check desktop/ui-smoke.js && node --check desktop/mvp-regression-test.js && node --check desktop/benchmark-engine.js && node --check desktop/electron-builder.release.cjs && node --check desktop/electron-builder.win-release.cjs && node --check desktop/release-signing-preflight.js && node --check desktop/release-signing-preflight-test.js && node --check desktop/release-signing-preflight-win.js && node --check desktop/release-signing-preflight-win-test.js && node --check scripts/check-desktop-license-materials.js && node --check scripts/release-readiness.js && node --check scripts/release-readiness-test.js && node --check scripts/generate-release-metadata.js",
    "test:licenses": "node scripts/check-desktop-license-materials.js",
    "test:release": "npm run test:licenses && node scripts/release-readiness-test.js && node desktop/release-signing-preflight-test.js && node desktop/release-signing-preflight-win-test.js && node scripts/release-readiness.js --channel internal --source-only",
    "release:check": "npm run release:check:mac",
    "release:check:mac": "npm run test:licenses && node scripts/release-readiness.js --channel public --platform macOS",
    "release:check:win": "npm run test:licenses && node scripts/release-readiness.js --channel public --platform windows --arch x64",
    "release:metadata": "npm run release:metadata:mac",
    "release:metadata:mac": "node scripts/generate-release-metadata.js --channel internal --platform macOS",
    "release:metadata:win": "node scripts/generate-release-metadata.js --channel internal --platform windows --arch x64"
  },
  "dependencies": {
    "@docflow-local/core": "0.1.0",
    "@docflow-local/license-verifier": "0.1.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.6.0",
    "busboy": "^1.6.0",
    "docx-preview": "^0.4.0",
    "docxtemplater": "^3.69.3",
    "exceljs": "^4.4.0",
    "image-size": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "ssf": "0.11.2",
    "@docflow-local/contracts": "0.1.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "brace-expansion": "5.0.8"
  },
  "build": {
    "appId": "com.docflow.local",
    "productName": "DocFlow Local",
    "copyright": "Copyright © 2026 DocFlow Local",
    "asar": true,
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "!desktop/*test.js",
      "!desktop/pdf-smoke.js",
      "!desktop/ui-smoke.js",
      "static/**/*",
      "LICENSE",
      "LICENSES/**/*",
      "NOTICE.md",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@fontsource/noto-sans-sc/**/*",
      "node_modules/@fontsource/noto-sans-sc/package.json",
      "node_modules/@fontsource/noto-sans-sc/LICENSE",
      "node_modules/@fontsource/noto-sans-sc/files/noto-sans-sc-chinese-simplified-400-normal.woff"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "DocFlow Local ${version}",
      "backgroundColor": "#F2F5F7",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 155,
          "y": 185,
          "type": "file"
        },
        {
          "x": 405,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocFlow Local",
      "artifactName": "DocFlow-Local-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "DocFlow-Local-${version}-${os}-${arch}.${ext}"
  }
}
